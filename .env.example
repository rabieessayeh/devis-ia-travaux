# Copier en .env et compléter (lu automatiquement par app.py). Ne jamais versionner .env.
# Sur Streamlit Community Cloud : mêmes valeurs dans Settings > Secrets (voir .streamlit/secrets.toml.example).

# LLM (API compatible OpenAI : Groq, OpenAI, Mistral, Ollama local...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Nombre maximal d'appels LLM par heure et par adresse IP
RATE_LIMIT_PER_HOUR=30
